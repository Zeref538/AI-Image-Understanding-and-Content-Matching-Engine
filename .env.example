# Copy to .env:  cp .env.example .env     (.env is git-ignored and docker-ignored)

POSTGRES_PASSWORD=change-me-local-only
# For running scripts or tests on your own machine against the compose database:
DATABASE_URL=postgresql://postgres:change-me-local-only@localhost:5434/images

# Models run locally in Ollama (ollama.com): no account, no key, no cost.
#   ollama pull qwen3.5:4b && ollama pull all-minilm
OLLAMA_URL=http://localhost:11434
# What the containers use to reach Ollama on your machine:
OLLAMA_URL_FROM_DOCKER=http://host.docker.internal:11434
VISION_MODEL=qwen3.5:4b
TEXT_MODEL=qwen3.5:4b
EMBED_MODEL=all-minilm
MODEL_TIMEOUT_S=120
